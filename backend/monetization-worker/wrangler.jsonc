{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mizan-monetization",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "development",
    "EXPECTED_PACKAGE_NAME": "com.lefferionprime.mizanglobal",
    "EXPECTED_PRODUCT_ID": "premium_lifetime",
    "REQUIRE_PLAY_INTEGRITY": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mizan-monetization",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "env": {
    "production": {
      "name": "mizan-monetization-production",
      "vars": {
        "ENVIRONMENT": "production",
        "EXPECTED_PACKAGE_NAME": "com.lefferionprime.mizanglobal",
        "EXPECTED_PRODUCT_ID": "premium_lifetime",
        "REQUIRE_PLAY_INTEGRITY": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mizan-monetization",
          "database_id": "REPLACE_WITH_D1_DATABASE_ID"
        }
      ]
    }
  }
}
