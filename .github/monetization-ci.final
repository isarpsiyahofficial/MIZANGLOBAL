name: MIZAN monetization audit

on:
  push:
    branches:
      - agent/mizan-monetization-premium
  pull_request:
    branches:
      - agent/mizanglobal-globalization

permissions:
  contents: read

env:
  FLUTTER_VERSION: "3.44.6"
  NODE_VERSION: "22"
  SOURCE_REF: ${{ github.event.pull_request.head.sha || github.sha }}

concurrency:
  group: monetization-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  flutter-analyze-test-build:
    runs-on: ubuntu-latest
    timeout-minutes: 35
    steps:
      - name: Checkout exact source head
        uses: actions/checkout@v4
        with:
          ref: ${{ env.SOURCE_REF }}
          fetch-depth: 0
      - name: Verify exact source head
        run: test "$(git rev-parse HEAD)" = "$SOURCE_REF"
      - uses: subosito/flutter-action@v2
        with:
          flutter-version: ${{ env.FLUTTER_VERSION }}
          channel: stable
          cache: true
      - name: Resolve dependencies
        run: flutter pub get
      - name: Analyze
        run: dart analyze --fatal-warnings
      - name: Run tests
        run: flutter test
      - name: Verify exact source before build
        run: |
          test "$(git rev-parse HEAD)" = "$SOURCE_REF"
          git diff --exit-code
      - name: Build Android debug APK with test ads
        run: >-
          flutter build apk --debug
          --dart-define=MIZAN_TEST_ADS=true
          --dart-define=MIZAN_REQUIRE_BILLING_BACKEND=false
      - name: Verify exact source after build
        run: |
          test "$(git rev-parse HEAD)" = "$SOURCE_REF"
          git diff --exit-code

  monetization-worker-check:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    defaults:
      run:
        working-directory: backend/monetization-worker
    steps:
      - name: Checkout exact source head
        uses: actions/checkout@v4
        with:
          ref: ${{ env.SOURCE_REF }}
          fetch-depth: 0
      - name: Verify exact source head
        working-directory: .
        run: test "$(git rev-parse HEAD)" = "$SOURCE_REF"
      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
      - name: Install Worker dependencies
        run: npm install --ignore-scripts
      - name: Typecheck and Wrangler dry run
        run: npm run check
